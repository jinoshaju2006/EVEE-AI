# Gemini text responses (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gemini image generation (model must be enabled for this API key)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional OpenAI-compatible provider (server-side only)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Planned PostgreSQL persistence milestone
DATABASE_URL=postgresql://postgres:password@localhost:5432/evee_ai
