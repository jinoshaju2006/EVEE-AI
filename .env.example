# Gemini is used for text/chat features. Keep API keys server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL for the next persistence/auth milestone
DATABASE_URL=postgresql://postgres:password@localhost:5432/evee_ai

# Cloudflare Workers AI image generation (FLUX.1 Schnell)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
