# Gemini is the recommended first provider. Keep all keys server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL for the next persistence/auth milestone
DATABASE_URL=postgresql://postgres:password@localhost:5432/evee_ai

# Optional image-generation model (defaults to Gemini 3.1 Flash Image)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
